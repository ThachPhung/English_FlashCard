# Local SQLite (mặc định khi không set):
# DATABASE_URL=sqlite:///./flashcard.db

# Production — Supabase PostgreSQL (Transaction pooler, port 6543):
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-1-[region].pooler.supabase.com:6543/postgres
# Nếu mật khẩu có ký tự đặc biệt (@, #, ...), encode trong URL: @ → %40

SECRET_KEY=change-this-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
